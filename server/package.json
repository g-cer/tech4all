{
  "name": "tech4all-server",
  "version": "1.0.0",
  "private": true,
  "description": "Back-end REST di Tech4All: API Express/TypeScript su MySQL.",
  "license": "MIT",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node ./src/server.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src scripts eslint.config.mjs jest.config.js",
    "lint:fix": "eslint src scripts eslint.config.mjs jest.config.js --fix",
    "db:setup": "ts-node ./scripts/setup-db.ts",
    "db:reset": "ts-node ./scripts/setup-db.ts --seed",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "sanitize-html": "2.13.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.13.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
