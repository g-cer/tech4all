# Connessione MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tech4all

# Segreto per la firma dei token di sessione (JWT).
# In produzione usare un valore casuale lungo, es. `openssl rand -hex 32`.
JWT_SECRET=cambiami-con-un-segreto-casuale
JWT_EXPIRES_IN=2h

# Server
PORT=5000
NODE_ENV=development

# Origine del front-end autorizzata dal CORS (deve combaciare con l'URL di Next.js)
CLIENT_ORIGIN=http://localhost:3000
