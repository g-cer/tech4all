# URL di base dell'API Tech4All.
# Deve coincidere con l'origine autorizzata dal CORS del server (CLIENT_ORIGIN).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Identificativo del progetto Voiceflow per l'assistente conversazionale.
